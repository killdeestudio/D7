{
  "name": "d7-survival",
  "version": "0.1.0",
  "private": true,
  "description": "D-7 재난 생존 — Reigns 스타일 카드 스와이프 재난 대비 시뮬레이션 (Android/iOS)",
  "scripts": {
    "start": "npx --yes http-server www -p 8080 -c-1",
    "test": "node --test tests/engine.test.js tests/i18n.test.js",
    "i18n": "node tools/build-i18n.js",
    "balance": "node tests/simulate.js 1000",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2"
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2"
  }
}
